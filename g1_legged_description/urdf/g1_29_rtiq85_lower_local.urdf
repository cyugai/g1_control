<joint name="Right_finger_joint" type="fixed">
  <origin xyz="0.0306011444260539 0 0.0627920162695395" rpy="0 0 0"/>
  <parent link="Right_robotiq_85_base_link"/>
  <!-- 注意：左侧文件中该关节连接的是 Left_left_outer_knuckle，
       右侧则采用镜像，对应连接 Right_right_outer_knuckle -->
  <child link="Right_right_outer_knuckle"/>
  <axis xyz="0 -1 0"/>
  <limit lower="0" upper="0.725" velocity="2.0" effort="1000"/>
</joint>

